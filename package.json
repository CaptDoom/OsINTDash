{
  "name": "india-neighbor-news-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "dev:server": "python backend/run.py",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.23",
    "bullmq": "^5.8.5",
    "cheerio": "^1.0.0",
    "concurrently": "^9.0.1",
    "cors": "^2.8.0",
    "d3-geo": "^3.1.1",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "jsdom": "^24.1.0",
    "@mozilla/readability": "^0.5.0",
    "nedb-promises": "^6.2.3",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
