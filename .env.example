# Primary News API (NewsAPI.org)
NEWS_API_KEY=your_news_api_key_here

# Fallback News APIs
GNEWS_API_KEY=your_gnews_key_here
CURRENTS_API_KEY=
THENEWS_API_KEY=your_thenews_key_here
MEDIASTACK_API_KEY=
NEWSCATCHER_API_KEY=
BING_NEWS_API_KEY=

# LLM Configurations for Enrichment and Search
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ScraperAPI configuration
SCRAPER_API_KEY=your_scraper_api_key_here
