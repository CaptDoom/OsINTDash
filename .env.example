# Application
APP_ENV=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=3001
VITE_API_BASE_URL=http://localhost:3001

# Database and cache
DATABASE_URL=postgresql+asyncpg://drishya_user:drishya_password@localhost:5432/drishya_db
REDIS_URL=redis://localhost:6379/0
USE_SQLITE_FALLBACK=true
ENABLE_DEMO_SEED_DATA=false
ENABLE_PERIODIC_INGESTION=true

# Primary news providers
NEWS_API_KEY=
NEWSDATA_API_KEY=
NEWSCATCHER_API_KEY=

# Secondary news providers
WORLD_NEWS_API_KEY=
GNEWS_API_KEY=
CURRENTS_API_KEY=
THENEWS_API_KEY=
MEDIASTACK_API_KEY=
BING_NEWS_API_KEY=
FREENEWSAPI_KEY=
FINNHUB_API_KEY=

# News pipeline controls
REQUEST_TIMEOUT_SECONDS=12
REQUEST_RETRY_COUNT=4
RATE_LIMIT_RETRY_COUNT=3
SERVER_ERROR_RETRY_COUNT=2
PROVIDER_CONCURRENCY=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RATE_LIMIT_THRESHOLD=5
CIRCUIT_BREAKER_AUTH_COOLDOWN_SECONDS=1800
CIRCUIT_BREAKER_RATE_LIMIT_COOLDOWN_SECONDS=900
CIRCUIT_BREAKER_SERVER_ERROR_COOLDOWN_SECONDS=300

# LLM enrichment
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Weather and scraping
OPENWEATHERMAP_API_KEY=
OPENWEATHER_API_KEY=
SCRAPER_API_KEY=
NOMINATIM_USER_AGENT=drishya-news-pipeline/1.0

# WebSub
WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/
CALLBACK_HOST=
